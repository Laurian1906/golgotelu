# Copy this file to `.env` and fill in the keys there. `.env` is not committed.
# Server secret: the key is read only on the machine that runs the app.

# ─────────────────────────────────────────────────────────────────────────────
# AI Model Keys (at least one required for full functionality)
# ─────────────────────────────────────────────────────────────────────────────

# Google Gemini API key (from Google AI Studio, free tier available).
GEMINI_API_KEY=

# Cerebras API key (optional fallback when Gemini is unavailable).
CEREBRAS_API_KEY=

# OpenRouter API key (optional fallback).
OPENROUTER_API_KEY=

# Respan hosted gateway (https://api.respan.ai/api). Optional: without it the app runs exactly as before and the
# gateway model is skipped. Create a key at https://platform.respan.ai/platform/gateway/api-keys
RESPAN_API_KEY=

# Model asked from the gateway, as "<provider>:<model>" (see platform.respan.ai/platform/models).
# RESPAN_MODEL=respan:gemini/gemini-3.5-flash

# ─────────────────────────────────────────────────────────────────────────────
# Cloud deployment (Vercel/Neon) — local development does not need these.
# ─────────────────────────────────────────────────────────────────────────────

# Postgres connection string from Neon (Vercel Marketplace).
# DATABASE_URL=postgres://user:pass@host/db?sslmode=require

# Encryption key for tokens (refresh tokens stored in DB).
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# TOKEN_ENCRYPTION_KEY=

# Microsoft Entra app for login and OneDrive (Phase 5).
# MS_CLIENT_ID=
# MS_CLIENT_SECRET=
# MS_REDIRECT_URI=https://your-app.vercel.app/api/auth/callback

# Emails allowed to log in (comma-separated).
# ALLOWED_EMAILS=user@example.com

# Session secret for SessionMiddleware.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
# SESSION_SECRET=

# Cron endpoint protection (Vercel sets CRON_SECRET automatically).
# CRON_SECRET=

# Budget overrides for cloud (optional).
# GEMINI_DAILY_BUDGET=15
# AGENT_RESERVE=4
# CHAT_RESERVE=3

# ─────────────────────────────────────────────────────────────────────────────
# Desktop app: cloud mode (optional)
# ─────────────────────────────────────────────────────────────────────────────

# If set, the Electron app loads from this URL instead of starting a local server.
# The Windows scheduled task for autopilot is hidden (Vercel cron takes over).
# GOLGOTELU_URL=https://your-app.vercel.app
